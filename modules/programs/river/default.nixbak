{
  config,
  lib,
  pkgs,
  ...
}: let
  inherit (lib) mkIf mkEnableOption mkOption types optionalString genAttrs;
  cfg = config.cnix.programs.river;
  acct = config.cnix.settings.accounts;

  systemctl = "${pkgs.systemd}/bin/systemctl";

  riverInit = pkgs.writeShellScript "river-init" ''
    exec 2> >(${pkgs.coreutils}/bin/tee -a "''${XDG_RUNTIME_DIR:-/tmp}/river.log" >&2)
    export PATH=${lib.makeBinPath cfg.configPackages}''${PATH:+:$PATH}
    export XDG_CURRENT_DESKTOP=river
    export XDG_SESSION_TYPE=wayland
    ${systemctl} --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
    ${systemctl} --user start river-session.target
    ${optionalString (cfg.extraInit != "") cfg.extraInit}
    ${cfg.rhinePackage}/bin/rhine
    ${systemctl} --user stop river-session.target
  '';

  riverCommand = "${cfg.package}/bin/river -c ${riverInit}";

  sessionPackage = pkgs.writeTextFile {
    name = "river-session";
    destination = "/share/wayland-sessions/river.desktop";
    text = ''
      [Desktop Entry]
      Name=River
      Comment=River with the rhine window manager
      Exec=${riverCommand}
      Type=Application
      DesktopNames=river
    '';
    passthru.providedSessions = ["river"];
  };

  mod = cfg.modifier;
in {
  options.cnix.programs.river = {
    enable = mkEnableOption "Enables river with the rhine window manager";

    package = mkOption {
      type = types.package;
      default = pkgs.river-next;
      defaultText = lib.literalExpression "pkgs.river-next";
      description = "The river compositor, 0.4+. Must match rhinePackage's protocol version.";
    };

    rhinePackage = mkOption {
      type = types.package;
      default = pkgs.rhine;
      defaultText = lib.literalExpression "pkgs.rhine";
      description = "The rhine window manager. Requires zig 0.16.";
    };

    channelPackage = mkOption {
      type = types.nullOr types.package;
      default = pkgs.channel;
      defaultText = lib.literalExpression "pkgs.channel";
      description = ''
        channel, rhine's companion input-configuration daemon. Rhine will not
        configure input devices at all, so setting this to null leaves you with
        no accel profile, no touchpad settings, and only the XKB_DEFAULT_*
        fallback for the keyboard.

        Added to the startup block automatically when non-null.
      '';
    };

    command = mkOption {
      type = types.str;
      readOnly = true;
      default = riverCommand;
      description = "The full command that starts this session, for greetd.";
    };

    configPackages = mkOption {
      type = types.listOf types.package;
      default =
        (with pkgs; [
          fuzzel
          wl-clipboard
          wireplumber
          brightnessctl
          playerctl
          kanshi
          procps
          dbus
          swayidle
        ])
        ++ [config.cnix.scripts.screenshot.package];
      description = ''
        Packages whose binaries the rh config calls by name, in keybinds and in
        the startup block. Put on PATH before rhine starts, so its `sh -c`
        children resolve under greetd where the session environment is minimal.

        Applications you launch from binds (ghostty, zen, nautilus, ashell)
        belong in your normal systemPackages, not here. This list exists for
        things the config itself would otherwise fail to find.
      '';
    };

    modifier = mkOption {
      type = types.enum ["super" "alt" "ctrl"];
      default = "alt";
      description = ''
        Primary modifier. Defaults to alt.
      '';
    };

    xkb = {
      layout = mkOption {
        type = types.str;
        default = "se";
        example = "us";
      };
      variant = mkOption {
        type = types.str;
        default = "nodeadkeys";
        example = "nodeadkeys";
        description = ''
          nodeadkeys is a variant, not an option: there is no xkb option by that
          name and it is silently dropped if passed as one.
        '';
      };
      options = mkOption {
        type = types.str;
        default = "";
        example = "compose:ralt";
        description = "Comma-separated xkb options. All real options are namespaced (grp:, lv3:, caps:, ...).";
      };
    };

    extraInit = mkOption {
      type = types.lines;
      default = "";
      description = ''
        Commands run after graphical-session.target is up but before rhine
        starts. Usually empty: rhine's own `startup []` block is the right place
        for daemons, since they then inherit rhine's `env {}` and its spoofed
        HYPRLAND_INSTANCE_SIGNATURE.
      '';
    };

    config = mkOption {
      type = types.lines;
      description = ''
        The full contents of ~/.config/river/config.rh, shared by rhine and
        channel. Rhine hot-reloads this when it changes, and falls back to its
        built-in minimal.rh if it fails to parse, so a config that appears to
        "revert" is a syntax error, not a lost file.
      '';
      default = ''
        layout {
            * bsp
        }

        layout_config {
            bsp {
                # Each leaf insets by `gaps` on every side, so adjacent windows
                # end up 2*gaps apart. 2 here matches niri's `gaps 4`.
                gaps 2
                # Drop gaps entirely when a workspace holds one window.
                smart_gaps true
            }
        }

        env {
            XDG_CURRENT_DESKTOP river
            ELECTRON_OZONE_PLATFORM_HINT wayland
            QT_QPA_PLATFORM wayland
            SDL_VIDEODRIVER wayland,x11
            GTK_CSD 0
        }

        window_management {
            focus_follows_pointer true
            pointer_follows_focus true

            float_move 0.1

            border {
                width 4
                colours {
                    focus rgb8, 0x4c, 0x7a, 0x5d
                    inactive rgb8, 0x50, 0x49, 0x45
                }
            }
        }

        animations {
            move {
                duration 125_000
                easing expOut
            }
            resize {
                duration 125_000
                easing expOut
            }
            workspace {
                duration 125_000
                easing sinInOut
            }
        }

        keybinds [
            ${mod}, Return, launch, ghostty
            ${mod}, t, launch, ghostty
            ${mod}, space, launch, fuzzel
            ${mod}, w, launch, zen
            ${mod}+shift, w, launch, zen --private-window
            ${mod}, e, launch, nautilus
            ${mod}, i, launch, byt
            ${mod}+shift, l, launch, loginctl lock-session
            ctrl+shift, Escape, launch, pgrep resources || resources

            ${mod}, q, close, Focus
            ${mod}, f, fullscreen, toggle, Focus
            ${mod}, v, floating, toggle, Focus
            ${mod}, s, layoutCommand, bsp, changeSplit
            ${mod}+shift, s, layoutCommand, bsp, swapAllSplits

            ${mod}, h, moveFocus, Left
            ${mod}, j, moveFocus, Down
            ${mod}, k, moveFocus, Up
            ${mod}, l, moveFocus, Right
            ${mod}, Left, moveFocus, Left
            ${mod}, Down, moveFocus, Down
            ${mod}, Up, moveFocus, Up
            ${mod}, Right, moveFocus, Right

            ${mod}+shift, h, moveWindow, Left
            ${mod}+shift, j, moveWindow, Down
            ${mod}+shift, k, moveWindow, Up
            ${mod}+shift, l, moveWindow, Right
            ${mod}+shift, Left, moveWindow, Left
            ${mod}+shift, Down, moveWindow, Down
            ${mod}+shift, Up, moveWindow, Up
            ${mod}+shift, Right, moveWindow, Right

            ${mod}, Tab, focusWorkspace, PrevActive
            ${mod}+ctrl, Left, focusWorkspace, Previous
            ${mod}+ctrl, Right, focusWorkspace, Next

            ${mod}, 1, focusWorkspace, 0
            ${mod}, 2, focusWorkspace, 1
            ${mod}, 3, focusWorkspace, 2
            ${mod}, 4, focusWorkspace, 3
            ${mod}, 5, focusWorkspace, 4
            ${mod}, 6, focusWorkspace, 5
            ${mod}, 7, focusWorkspace, 6
            ${mod}, 8, focusWorkspace, 7
            ${mod}, 9, focusWorkspace, 8

            ${mod}+shift, 1, moveToWorkspace, 0
            ${mod}+shift, 2, moveToWorkspace, 1
            ${mod}+shift, 3, moveToWorkspace, 2
            ${mod}+shift, 4, moveToWorkspace, 3
            ${mod}+shift, 5, moveToWorkspace, 4
            ${mod}+shift, 6, moveToWorkspace, 5
            ${mod}+shift, 7, moveToWorkspace, 6
            ${mod}+shift, 8, moveToWorkspace, 7
            ${mod}+shift, 9, moveToWorkspace, 8

            none,  Insert, launch, screenshot.sh area
            shift, Insert, launch, screenshot.sh output
            alt,   Insert, launch, screenshot.sh ocr
            ctrl,  Insert, launch, screenshot.sh screen

            none, XF86AudioRaiseVolume, launch, wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && wpctl set-volume @DEFAULT_AUDIO_SINK@ --limit 1.0 5%+
            none, XF86AudioLowerVolume, launch, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
            none, XF86AudioMute, launch, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
            none, XF86AudioMicMute, launch, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
            none, XF86AudioPlay, launch, playerctl play-pause
            none, XF86AudioNext, launch, playerctl next
            none, XF86AudioPrev, launch, playerctl previous
            none, XF86MonBrightnessUp, launch, brightnessctl --class=backlight set +10%
            none, XF86MonBrightnessDown, launch, brightnessctl --class=backlight set 10%-

            ${mod}+shift, Delete, exit
        ]

        pointer_binds [
            ${mod}, Left, pointerOp, move
            ${mod}, Right, pointerOp, resize
        ]

        windowrules [
            byt, float, true
            vesktop, workspace, 4
        ]

        startup [
            dbus-update-activation-environment --all --systemd
            kanshi
            ashell
            swayidle
        ]

        input {
            profiles {
                keyboard {
                    keyboard {
                        layout ${cfg.xkb.layout}
                        variant ${cfg.xkb.variant}
                        options ${cfg.xkb.options}
                        repeat {
                            rate 50
                            delay 300
                        }
                    }
                }

                mouse {
                    libinput {
                        accel_profile flat
                        accel_speed 0
                    }
                }

                touchpad {
                    libinput {
                        natural_scroll true
                        tap_to_click true
                        click_method clickfinger
                        disable_while_typing true
                        scroll_method two_finger
                        accel_profile adaptive
                    }
                }
            }

            rules [
                type, keyboard, keyboard
                type, pointer, mouse
                name, *ouchpad, touchpad
            ]
        }
      '';
    };
  };

  config = mkIf cfg.enable {
    warnings = lib.optional (cfg.channelPackage == null) ''
      cnix.programs.river: channelPackage is unset. Rhine does not configure
      input devices, so accel profile, tap-to-click and the rest of the input{}
      block will have no effect; only XKB_DEFAULT_* applies.
    '';

    environment = {
      sessionVariables =
        {
          NIXOS_OZONE_WL = "1";
          XKB_DEFAULT_LAYOUT = cfg.xkb.layout;
        }
        // lib.optionalAttrs (cfg.xkb.variant != "") {
          XKB_DEFAULT_VARIANT = cfg.xkb.variant;
        }
        // lib.optionalAttrs (cfg.xkb.options != "") {
          XKB_DEFAULT_OPTIONS = cfg.xkb.options;
        };

      systemPackages =
        [
          cfg.package
          cfg.rhinePackage
        ]
        ++ lib.optional (cfg.channelPackage != null) cfg.channelPackage
        ++ cfg.configPackages
        ++ (with pkgs; [wayland-utils]);
    };

    services.displayManager.sessionPackages = [sessionPackage];

    hjem.users = genAttrs acct.defaultUsers (_user: {
      files.".config/river/config.rh" = {
        text =
          cfg.config
          + optionalString (cfg.channelPackage != null) ''

            # Appended by the module: channel is the input daemon, and must be
            # running for the input{} block above to have any effect. Multiple
            # startup[] blocks merge.
            startup [
                ${cfg.channelPackage}/bin/channel
            ]
          '';
        clobber = true;
      };
    });

    xdg.portal = {
      enable = true;
      extraPortals = with pkgs; [
        xdg-desktop-portal-wlr
        xdg-desktop-portal-gtk
      ];
      config.river = {
        default = ["wlr" "gtk"];
        "org.freedesktop.impl.portal.FileChooser" = ["gtk"];
      };
    };

    systemd.user.targets.river-session = {
      description = "river session";
      bindsTo = ["graphical-session.target"];
      before = ["graphical-session.target"];
      wants = ["graphical-session-pre.target"];
      after = ["graphical-session-pre.target"];
    };

    security.polkit.enable = true;
    programs.dconf.enable = lib.mkDefault true;
  };
}
